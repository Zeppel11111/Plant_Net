<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900">
  <style>
    .title{font:700 32px 'Microsoft YaHei','Noto Sans CJK SC',sans-serif;fill:#172033}.sub{font:16px 'Microsoft YaHei','Noto Sans CJK SC',sans-serif;fill:#61708a}.box-title{font:700 22px 'Microsoft YaHei','Noto Sans CJK SC',sans-serif;fill:#fff}.label{font:600 17px 'Microsoft YaHei','Noto Sans CJK SC',sans-serif;fill:#1e293b}.small{font:14px 'Microsoft YaHei','Noto Sans CJK SC',sans-serif;fill:#475569}.pin{font:600 15px 'Consolas','Microsoft YaHei',sans-serif;fill:#1e293b}.note{font:14px 'Microsoft YaHei','Noto Sans CJK SC',sans-serif;fill:#64748b}.wire{fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:5}.dot{stroke:#fff;stroke-width:3}
  </style>
  <rect width="1600" height="900" fill="#f8fafc"/>
  <rect x="42" y="35" width="1516" height="830" rx="22" fill="#fff" stroke="#dbe4f0" stroke-width="2"/>
  <text x="85" y="98" class="title">Plant_Net 扩展板 · 简约 PINOUT 接线图</text>
  <text x="85" y="130" class="sub">开发板直插扩展板｜红：3.3 V　黑：GND　蓝：模块 TX → STM32 RX　橙：STM32 TX → 模块 RX</text>

  <!-- ESP-01S -->
  <rect x="105" y="255" width="300" height="335" rx="16" fill="#e8f0ff" stroke="#356ae6" stroke-width="3"/>
  <rect x="105" y="255" width="300" height="55" rx="14" fill="#356ae6"/>
  <text x="255" y="291" text-anchor="middle" class="box-title">ESP-01S（ESP8266）</text>
  <text x="137" y="348" class="pin">VCC</text><circle cx="405" cy="342" r="7" fill="#ef4444" class="dot"/>
  <text x="137" y="395" class="pin">GND</text><circle cx="405" cy="389" r="7" fill="#1f2937" class="dot"/>
  <text x="137" y="442" class="pin">RXD</text><circle cx="405" cy="436" r="7" fill="#f59e0b" class="dot"/>
  <text x="137" y="489" class="pin">TXD</text><circle cx="405" cy="483" r="7" fill="#2563eb" class="dot"/>
  <text x="137" y="536" class="pin">EN / CH_PD</text><circle cx="405" cy="530" r="7" fill="#ef4444" class="dot"/>
  <text x="255" y="571" text-anchor="middle" class="note">Wi‑Fi 数据上行</text>

  <!-- STM32 -->
  <rect x="570" y="225" width="430" height="380" rx="20" fill="#ecfeff" stroke="#0f766e" stroke-width="3"/>
  <rect x="570" y="225" width="430" height="62" rx="18" fill="#0f766e"/>
  <text x="785" y="265" text-anchor="middle" class="box-title">STM32F103C8T6 最小系统板</text>
  <text x="785" y="313" text-anchor="middle" class="small">扩展板只使用以下 6 个 IO</text>
  <!-- left STM32 pins -->
  <circle cx="570" cy="342" r="7" fill="#ef4444" class="dot"/><text x="592" y="348" class="pin">3.3V</text>
  <circle cx="570" cy="389" r="7" fill="#1f2937" class="dot"/><text x="592" y="395" class="pin">GND</text>
  <circle cx="570" cy="436" r="7" fill="#f59e0b" class="dot"/><text x="592" y="442" class="pin">PB10 · USART3_TX</text>
  <circle cx="570" cy="483" r="7" fill="#2563eb" class="dot"/><text x="592" y="489" class="pin">PB11 · USART3_RX</text>
  <!-- right STM32 pins -->
  <text x="976" y="348" text-anchor="end" class="pin">PA2 · USART2_TX</text><circle cx="1000" cy="342" r="7" fill="#f59e0b" class="dot"/>
  <text x="976" y="395" text-anchor="end" class="pin">PA3 · USART2_RX</text><circle cx="1000" cy="389" r="7" fill="#2563eb" class="dot"/>
  <text x="976" y="442" text-anchor="end" class="pin">3.3V</text><circle cx="1000" cy="436" r="7" fill="#ef4444" class="dot"/>
  <text x="976" y="489" text-anchor="end" class="pin">GND</text><circle cx="1000" cy="483" r="7" fill="#1f2937" class="dot"/>
  <!-- bottom debug pins -->
  <text x="700" y="575" text-anchor="middle" class="pin">PA9 · DBG_TX</text><circle cx="700" cy="605" r="7" fill="#f59e0b" class="dot"/>
  <text x="870" y="575" text-anchor="middle" class="pin">PA10 · DBG_RX</text><circle cx="870" cy="605" r="7" fill="#2563eb" class="dot"/>

  <!-- RS485 -->
  <rect x="1165" y="255" width="270" height="280" rx="16" fill="#e7faf4" stroke="#0f9f78" stroke-width="3"/>
  <rect x="1165" y="255" width="270" height="55" rx="14" fill="#0f9f78"/>
  <text x="1300" y="291" text-anchor="middle" class="box-title">串口转 RS485 模块</text>
  <circle cx="1165" cy="342" r="7" fill="#f59e0b" class="dot"/><text x="1185" y="348" class="pin">TXD / DI</text>
  <circle cx="1165" cy="389" r="7" fill="#2563eb" class="dot"/><text x="1185" y="395" class="pin">RXD / RO</text>
  <circle cx="1165" cy="436" r="7" fill="#ef4444" class="dot"/><text x="1185" y="442" class="pin">VCC</text>
  <circle cx="1165" cy="483" r="7" fill="#1f2937" class="dot"/><text x="1185" y="489" class="pin">GND</text>
  <text x="1408" y="396" text-anchor="end" class="pin">A</text><circle cx="1435" cy="389" r="7" fill="#7c3aed" class="dot"/>
  <text x="1408" y="443" text-anchor="end" class="pin">B</text><circle cx="1435" cy="436" r="7" fill="#db2777" class="dot"/>

  <!-- Sensor terminal -->
  <rect x="1445" y="285" width="110" height="280" rx="12" fill="#fff7e6" stroke="#e18a16" stroke-width="3"/>
  <text x="1500" y="327" text-anchor="middle" class="label">塔石</text><text x="1500" y="349" text-anchor="middle" class="label">传感器</text>
  <circle cx="1445" cy="389" r="7" fill="#7c3aed" class="dot"/><text x="1470" y="395" class="pin">A</text>
  <circle cx="1445" cy="436" r="7" fill="#db2777" class="dot"/><text x="1470" y="442" class="pin">B</text>
  <circle cx="1445" cy="483" r="7" fill="#ef4444" class="dot"/><text x="1470" y="489" class="pin">V+</text>
  <circle cx="1445" cy="530" r="7" fill="#1f2937" class="dot"/><text x="1470" y="536" class="pin">GND</text>

  <!-- links ESP -->
  <path d="M405 342 H495 V342 H570" class="wire" stroke="#ef4444"/>
  <path d="M405 389 H480 V389 H570" class="wire" stroke="#1f2937"/>
  <path d="M405 436 H510 V436 H570" class="wire" stroke="#f59e0b"/>
  <path d="M405 483 H495 V483 H570" class="wire" stroke="#2563eb"/>
  <path d="M405 530 H455 V342 H570" class="wire" stroke="#ef4444"/>
  <text x="422" y="320" class="note" fill="#dc2626">EN / CH_PD → +3.3V</text>
  <text x="480" y="365" class="note" fill="#dc2626">+3.3V</text>
  <!-- links RS485 -->
  <path d="M1000 342 H1165" class="wire" stroke="#f59e0b"/>
  <path d="M1000 389 H1165" class="wire" stroke="#2563eb"/>
  <path d="M1000 436 H1165" class="wire" stroke="#ef4444"/>
  <path d="M1000 483 H1165" class="wire" stroke="#1f2937"/>
  <path d="M1435 389 H1445" class="wire" stroke="#7c3aed"/>
  <path d="M1435 436 H1445" class="wire" stroke="#db2777"/>

  <!-- debug -->
  <rect x="650" y="680" width="270" height="105" rx="15" fill="#f4f1ff" stroke="#7757d9" stroke-width="3"/>
  <text x="785" y="722" text-anchor="middle" class="label">USB‑TTL / VOFA（可选）</text>
  <text x="785" y="753" text-anchor="middle" class="small">3.3V · GND · TX · RX</text>
  <path d="M700 605 V680" class="wire" stroke="#f59e0b"/>
  <path d="M870 605 V680" class="wire" stroke="#2563eb"/>

  <!-- ESPCAM independent -->
  <rect x="120" y="665" width="350" height="120" rx="16" fill="#f1f5f9" stroke="#64748b" stroke-width="3" stroke-dasharray="8 7"/>
  <text x="295" y="709" text-anchor="middle" class="label">ESP32‑CAM（独立节点）</text>
  <text x="295" y="741" text-anchor="middle" class="small">Micro‑USB 5V 连接 · 独立供电/烧录</text>
  <text x="295" y="768" text-anchor="middle" class="small">不接扩展板，Wi‑Fi 直连服务器</text>
  <path d="M470 725 C525 660 550 660 600 700" fill="none" stroke="#16a34a" stroke-width="4" stroke-dasharray="10 8"/>
  <text x="510" y="676" class="note">Wi‑Fi/TCP</text>

  <!-- 12V sensor supply -->
  <rect x="1130" y="665" width="300" height="115" rx="15" fill="#fff1f2" stroke="#dc2626" stroke-width="3"/>
  <text x="1280" y="708" text-anchor="middle" class="label">传感器电源输入</text>
  <text x="1280" y="740" text-anchor="middle" class="pin" fill="#dc2626">+12V</text>
  <text x="1280" y="765" text-anchor="middle" class="small">仅供塔石 V+；GND 与系统共地</text>
  <path d="M1445 483 V620 H1410 V715" class="wire" stroke="#ef4444"/>
  <path d="M1445 530 V640 H1160 V755" class="wire" stroke="#1f2937"/>
  <text x="1418" y="610" class="note" fill="#dc2626">+12V</text>
  <text x="1040" y="645" class="note">GND 共地（STM32 / RS485 / 传感器）</text>

  <text x="85" y="830" class="note">预留 / NC（不从扩展板引出）：PC13、PD0/PD1、PB6/PB7、PA13/PA14、NRST、BOOT0</text>
</svg>
